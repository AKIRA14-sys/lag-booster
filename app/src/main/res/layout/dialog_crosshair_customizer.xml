<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F00B0E14"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ CROSSHAIR LAB CUSTOMIZER"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_preset_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_dialog_title"
            android:text="Preset: Tactical Standard #1 [NORMAL]"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FF1744" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_normal"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="LIVE TARGETING PREVIEW"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/bg_quick_crosshair">

                <com.lagbooster.crosshair.CrosshairView
                    android:id="@+id/preview_crosshair_view"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_tier_normal"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#FF1744"
                    android:paddingHorizontal="8dp"
                    android:text="NORMAL"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_tier_pro"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#292D39"
                    android:paddingHorizontal="8dp"
                    android:text="PRO"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_tier_legendary"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#292D39"
                    android:paddingHorizontal="8dp"
                    android:text="MYTHIC"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_tier_god"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#292D39"
                    android:paddingHorizontal="8dp"
                    android:text="GOD"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1.2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crosshair Color"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layout_color_palette"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Scale / Size"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_size_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="32 dp"
                        android:textColor="#00E5FF"
                        android:textSize="12sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekbar_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:max="64"
                    android:min="12"
                    android:progress="32"
                    android:progressTint="#FF1744"
                    android:thumbTint="#FF1744" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Opacity"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_opacity_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textColor="#00E5FF"
                        android:textSize="12sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekbar_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:max="100"
                    android:min="20"
                    android:progress="100"
                    android:progressTint="#FF1744"
                    android:thumbTint="#FF1744" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rotation Angle"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_rotation_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0°"
                        android:textColor="#00E5FF"
                        android:textSize="12sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekbar_rotation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:max="360"
                    android:progress="0"
                    android:progressTint="#FF1744"
                    android:thumbTint="#FF1744" />

                <CheckBox
                    android:id="@+id/cb_red_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Enable Tactical Red Center Dot"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/cb_auto_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Auto-launch Overlay for current game"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_reset_customizer"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:text="RESET"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_save_apply"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#FF1744"
            android:text="SAVE &amp; ACTIVATE OVERLAY"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
